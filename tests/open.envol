// Opening a file: its folders open in the sidebar, it is selected there, its tab and text
// show, and the status bar names it from the folder. Folders come first, names in order
// without case, and build output is left out.
// expect: sidebar: docs, src, lib.envol, main.envol, README.md, Zeta.md
// expect: opened: true
// expect: selected: lib.envol
// expect: src open: true
// expect: tab: lib.envol
// expect: first line: // lib
// expect: status: src/lib.envol    Ln 1, Col 1
// expect: missing: false
use envor.theme;
use std.fs;

fs.CreateDirAll("open-test/src");
fs.CreateDirAll("open-test/docs");
fs.CreateDirAll("open-test/build");
fs.WriteText("open-test/src/main.envol", "print(\"hi\");\n");
fs.WriteText("open-test/src/lib.envol", "// lib\n");
fs.WriteText("open-test/Zeta.md", "z\n");
fs.WriteText("open-test/README.md", "# r\n");

Shell s = NewShell("open-test");
string items = string.From("sidebar: ");
for (usize i = 0; i < s.T.ItemCount(s.Files); i++) {
    if (i > 0) items.Append(", ");
    items.Append(s.T.ItemText(s.Files, i));
}
print(items.AsStr());

bool ok = s.Open("src/lib.envol");
print(Line("opened: ", Yes(ok)).AsStr());
print(Line("selected: ", s.T.ItemText(s.Files, s.T.Selected(s.Files))).AsStr());
print(Line("src open: ", Yes(s.T.IsOpen(s.Files, 1))).AsStr());
print(Line("tab: ", s.T.ItemText(s.Tabs, 0)).AsStr());
string body = s.T.Value(s.Editor);
str all = body.AsStr();
usize end = 0;
while (end < all.Len && all[end] != 10) end++;
print(Line("first line: ", all[0..end]).AsStr());
string status = s.StatusText();
print(Line("status: ", status.AsStr()).AsStr());
print(Line("missing: ", Yes(s.Open("nope.envol"))).AsStr());

str Yes(bool b) {
    if (b) return "true";
    return "false";
}

string Line(str a, str b) {
    string s = string.From(a);
    s.Append(b);
    return s;
}

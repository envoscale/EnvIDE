// Envide in a window: the shell (shell.envol), drawn each time nothing is waiting.
// `envide --one-frame` draws one frame and quits, for CI.
use envor.gfx;
use envor.font;
use envor.theme;
use ports.{EventKind};
use std.env;
use platform;

bool oneFrame = env.ArgCount() > 1 && SameText(env.Arg(1), "--one-frame");
var loaded = font.System("monospace");
if (loaded.IsErr()) {
    print("Envide needs a monospace font, and this system has none it knows");
    return 1;
}
font.Font f = loaded.Unwrap();
theme.Theme th = theme.Dark();
Shell s = NewShell(env.CurrentDir().AsStr());

var w = platform.Window();
if (!w.Open("Envide", 1100, 700)) {
    print("Envide needs a desktop: this system cannot open a window");
    return 1;
}
u32 width = w.Width();
u32 height = w.Height();
gfx.Canvas c = gfx.Canvas.New(width as i32, height as i32);
while (w.IsOpen() && !s.Quit) {
    var e = w.Poll();
    if (e.Is(EventKind.None)) {
        s.T.LayoutPixels(f, th, width as i32, height as i32);
        s.T.DrawPixels(ref c, f, th);
        w.Present(c.Pixels(), width, height);
        if (oneFrame) {
            print("envide: drew a frame");
            break;
        }
        continue;
    }
    if (e.Is(EventKind.Resize)) {
        width = w.Width();
        height = w.Height();
        c = gfx.Canvas.New(width as i32, height as i32);
        continue;
    }
    s.OnEvent(e);
}
if (w.IsOpen()) w.Close();
